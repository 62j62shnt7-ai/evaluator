{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-inspection-evaluator.local/schemas/evaluation-template-1.0.json",
  "title": "UT evaluation template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "version", "description", "source_file", "source_sha256", "sheets", "outputs", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "template_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sheets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "unit", "source_cells", "code_reference", "provenance_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.| -]+$"},
          "label": {"type": "string"},
          "kind": {"enum": ["input", "lookup", "formula", "output"]},
          "unit": {"type": "string"},
          "expression": {"type": "string"},
          "source_cells": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "additionalProperties": false, "required": ["sheet", "cell"], "properties": {"sheet": {"type": "string", "minLength": 1}, "cell": {"type": "string", "pattern": "^\\$?[A-Za-z]{1,3}\\$?\\d+$"}}}
          },
          "code_reference": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "edition", "clause", "status", "reason"],
            "properties": {"code": {"type": ["string", "null"]}, "edition": {"type": ["string", "null"]}, "clause": {"type": ["string", "null"]}, "status": {"enum": ["sheet_header", "unmapped", "not_applicable"]}, "reason": {"type": ["string", "null"]}}
          },
          "provenance_required": {"type": "array", "items": {"enum": ["sheet", "manual", "code_table"]}, "uniqueItems": true}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"enum": ["formula", "output"]}}}, "then": {"required": ["expression"]}, "else": {"not": {"required": ["expression"]}}},
          {"if": {"properties": {"kind": {"const": "input"}}}, "then": {"properties": {"provenance_required": {"minItems": 1}}}}
        ],
        "additionalProperties": false
      }
    }
  }
}
